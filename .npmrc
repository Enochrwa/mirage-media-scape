# NPM configuration

# Use exact versions for consistency
save-exact = true

# Require explicit install of peer dependencies
legacy-peer-deps = false

# Use git for dependencies when possible
git-tag-version = true

# Enable strict SSL for security unless explicitly disabled
strict-ssl = true

# Set default registry
registry = https://registry.npmjs.org/

# Set audit level for security scanning
audit-level = moderate

# Disable fund notification
fund = false

# Set workspace aware mode
workspaces-update = true

# Enable package-lock functionality
package-lock = true

# Set default install timeout
fetch-timeout = 60000

# Set retries for network operations
fetch-retries = 3

# Use package-imports when available
prefer-offline = false
