{
  "coverage": {
    "provider": "v8",
    "reporter": ["text", "text-summary", "html", "lcov", "json"],
    "lines": 80,
    "functions": 80,
    "branches": 80,
    "statements": 80,
    "exclude": [
      "node_modules/",
      "dist/",
      "**/*.test.ts",
      "**/*.spec.ts"
    ]
  },
  "testTimeout": 10000,
  "bail": true,
  "detectOpenHandles": true,
  "forceExit": true
}
