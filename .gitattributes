# Auto detect text files and normalize line endings to LF
* text=auto

# Source code
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.less text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Windows batch files genuinely require CRLF to run via cmd.exe (e.g. gradlew.bat)
*.bat text eol=crlf

# Java/Kotlin (Android native shell)
*.java text eol=lf
*.kt text eol=lf
*.gradle text eol=lf
gradlew text eol=lf

# Swift (iOS native shell)
*.swift text eol=lf
*.plist text eol=lf

# Rust code
*.rs text eol=lf
Cargo.toml text eol=lf
Cargo.lock text eol=lf

# Python
*.py text eol=lf

# Docker
Dockerfile text eol=lf
.dockerignore text eol=lf

# Git
.gitignore text eol=lf
.gitattributes text eol=lf

# Config files
.editorconfig text eol=lf
.npmrc text eol=lf
.nvmrc text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.mkv binary
*.webm binary
*.flac binary
*.m4a binary

# Build output
node_modules export-ignore
dist export-ignore
build export-ignore
target export-ignore

# Android / iOS binary artifacts (in case any are ever committed intentionally)
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
*.ipa binary
*.p12 binary
