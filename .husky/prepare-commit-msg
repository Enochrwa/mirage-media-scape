#!/bin/sh
# Husky prepare-commit-msg hook
# This hook rewrites the commit message if it's a PR merge, branch merge, etc.

set -e

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Don't edit merge commits or other special commits
if [ "$COMMIT_SOURCE" = "merge" ]; then
  exit 0
fi

# Optional: You can add custom logic here to auto-format commit messages
# For now, we'll just let the user write freely until commit

exit 0
