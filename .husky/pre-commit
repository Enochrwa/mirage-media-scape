#!/bin/sh
# Husky pre-commit hook

set -e

echo "🔍 Running pre-commit checks..."

# Find changed files
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

# Frontend checks
FRONTEND_FILES=$(echo "$CHANGED_FILES" | grep -E '^frontend/' | grep -E '\.(ts|tsx|js|jsx|json)$' || true)
if [ -n "$FRONTEND_FILES" ]; then
  echo "✓ Checking frontend code style..."
  cd frontend
  
  # Run linting
  npm run lint:fix
  
  # Type checking
  npm run type-check
  
  # Format check
  npm run format:check || npm run format
  
  cd ..
fi

# Server checks
SERVER_FILES=$(echo "$CHANGED_FILES" | grep -E '^server/' | grep -E '\.(ts|tsx|js|jsx|json)$' || true)
if [ -n "$SERVER_FILES" ]; then
  echo "✓ Checking server code style..."
  cd server
  
  npm run lint 2>/dev/null || true
  
  cd ..
fi

# Re-add formatted files
echo "✓ Adding formatted files back to staging..."
git add -A

echo "✅ Pre-commit checks passed!"
