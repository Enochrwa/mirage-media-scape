# Frontend Environment Variables
# Copy this file to .env.local and fill in the appropriate values

# API Configuration
#
# Web / desktop (Tauri) dev: localhost works fine, since the browser/webview runs
# on the same machine as the server.
#
# Mobile (Capacitor) dev: a phone cannot resolve "localhost" to your dev machine.
# Set this to your dev machine's LAN IP instead, e.g. http://192.168.1.50:3001
# (phone and dev machine must be on the same Wi-Fi network). Find your LAN IP:
#   macOS/Linux: ifconfig | grep "inet "
#   Windows:     ipconfig
# Or just run `npm run dev:mobile` from the repo root, which detects it for you.
VITE_API_BASE_URL=http://localhost:3001
VITE_API_TIMEOUT=30000

# FFmpeg Configuration (if using wasm version)
VITE_FFMPEG_CORE_URL=/ffmpeg
VITE_ENABLE_FFMPEG=true

# Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_SENTRY=false

# Build Configuration
VITE_BUILD_ENV=development
VITE_SOURCEMAP=true

# Optional: Sentry Configuration (if monitoring is enabled)
# SENTRY_DSN=https://your-key@sentry.io/project-id

# Optional: Analytics Configuration
# VITE_ANALYTICS_TOKEN=your-analytics-token
