{
  "name": "zovyra-media-server",
  "version": "1.0.0",
  "description": "Node.js backend for Zovyra Media Player",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "NODE_ENV=production node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test DATABASE_PATH=./zovyra.test.db NODE_OPTIONS=--experimental-vm-modules jest",
    "clean": "rm -rf dist node_modules package-lock.json",
    "reinstall": "npm run clean && npm install"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.1",
    "fast-xml-parser": "^5.7.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "multicast-dns": "^7.2.5",
    "node-fetch": "^3.3.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "ws": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^22.19.19",
    "@types/node-fetch": "^2.6.13",
    "@types/ws": "^8.18.1",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1"
  }
}
